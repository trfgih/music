{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "server",
    "outDir": "build-server"
  },
  "include": ["server/**/*.ts"],
  "exclude": ["server/**/*.test.ts"]
}
